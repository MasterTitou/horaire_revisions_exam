# =========================================================
# CONFIGURATION DES CLÉS API GEMINI & MODÈLES ACTIFS (Vercel / Local)
# =========================================================

# 1. Clé API Google Gemini (Obtenue sur https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Identifiants des Modèles Actifs (Google AI Studio)
# Modèle rapide (Parsing JSON & Structuration) : gemini-1.5-flash ou gemini-1.5-flash-8b
GEMINI_FAST_MODEL=gemini-1.5-flash

# Modèle stratégique (Arbitrage & Conseils) : gemini-1.5-pro ou gemini-1.5-flash
GEMINI_HEAVY_MODEL=gemini-1.5-pro

# 3. Authentification & Sécurité Application
AUTH_SECRET=revision-planner-default-secret
APP_PASSWORD=canard3434

# 4. Base de données PostgreSQL (Vercel Postgres ou Supabase)
POSTGRES_URL=postgresql://user:password@hostname:5432/dbname
