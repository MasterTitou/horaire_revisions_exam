# =========================================================
# CONFIGURATION DES CLÉS API GEMINI & MODÈLES (Vercel / Local)
# =========================================================

# 1. Clé API Google Gemini (Obtenue sur https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_LITE_API_KEY=
GEMINI_3_6_FLASH_API_KEY=

# 2. Modèles Stricts
# Modèle Rapide (Parsing JSON & Chat - Quota 500/j) : gemini-3.5-flash-lite
GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite
# Modèle Stratégique (Arbitrage & Surcharges - Quota 20/j) : gemini-3.6-flash
GEMINI_3_6_FLASH_MODEL=gemini-3.6-flash

# 3. Authentification & Sécurité Application
AUTH_SECRET=revision-planner-default-secret
APP_PASSWORD=canard3434
CRON_SECRET=revision-planner-cron-secret

# 4. Google OAuth 2.0 & Webhooks Push
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://horaire-revisions-exam.vercel.app/api/calendar/google?action=callback
GOOGLE_WEBHOOK_URL=https://horaire-revisions-exam.vercel.app/api/webhooks/google-calendar

# 5. Base de données PostgreSQL (Vercel Postgres ou Neon / Supabase)
POSTGRES_URL=postgresql://user:password@hostname:5432/dbname
