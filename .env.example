# =========================================================
# CONFIGURATION DES CLÉS API GEMINI & ENVIRONNEMENT (Vercel / Local)
# =========================================================

# 1. Clé API Principale Google Gemini (Requis pour l'IA)
# Obtenez votre clé sur https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Clés API Optionnelles par Niveau de Modèle (Si vous utilisez des clés distinctes)
# Modèle Niveau 1 : Gemini Flash-Lite (Quota : 500 requêtes / jour)
GEMINI_FLASH_LITE_API_KEY=your_gemini_flash_lite_key_here

# Modèle Niveau 2 : Gemini 3.6 Flash (Quota : 20 requêtes / jour)
GEMINI_3_6_FLASH_API_KEY=your_gemini_3_6_flash_key_here

# Nom du modèle stratégique 3.6 Flash (Optionnel, défaut: gemini-3.6-flash)
GEMINI_3_6_FLASH_MODEL=gemini-3.6-flash

# 3. Authentification & Sécurité Application
AUTH_SECRET=revision-planner-default-secret
APP_PASSWORD=canard3434

# 4. Base de données PostgreSQL (Vercel Postgres ou Supabase)
# Non requis en dev local (fallback automatique en mémoire)
POSTGRES_URL=postgresql://user:password@hostname:5432/dbname
