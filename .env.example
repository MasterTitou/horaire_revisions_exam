# =========================================================
# CONFIGURATION DES CLÉS API GEMINI & MODÈLES (Vercel / Local)
# =========================================================

# 1. Clé API Google Gemini (Obtenue sur https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Modèles Stricts
# Modèle Rapide (Parsing JSON & Chat - Quota 500/j) : gemini-3.5-flash-lite
GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite

# Modèle Stratégique (Arbitrage & Surcharges - Quota 20/j) : gemini-3.6-flash
GEMINI_3_6_FLASH_MODEL=gemini-3.6-flash

# 3. Authentification & Sécurité Application
AUTH_SECRET=revision-planner-default-secret
APP_PASSWORD=canard3434

# 4. Base de données PostgreSQL (Vercel Postgres ou Supabase)
POSTGRES_URL=postgresql://user:password@hostname:5432/dbname
